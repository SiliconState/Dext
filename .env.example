# Wolf provider selection (defaults to provider catalog active provider: glm)
# WOLF_PROVIDER=glm
# WOLF_MODEL=glm-4.6

# Optional hard overrides (usually managed via `wolf auth ...`)
# WOLF_BASE_URL=https://api.z.ai/api/anthropic
# WOLF_API_KEY=...

# Provider-specific env fallbacks
# ZAI_API_KEY=...
# ANTHROPIC_API_KEY=...
# OPENAI_API_KEY=...
# DEEPSEEK_API_KEY=...
# CHATGPT_ACCESS_TOKEN=...
# OPENROUTER_API_KEY=...

WOLF_EXTERNAL_TIMEOUT_SECS=60
WOLF_BASH_TIMEOUT_SECS=60
WOLF_HOOK_TIMEOUT_SECS=60

# Optional: override detected model context window (tokens) and compaction threshold (chars)
# WOLF_CONTEXT_WINDOW_TOKENS=200000
# WOLF_MAX_HISTORY_CHARS=280000

# pi-memory: pin this repo to the explicit project name used for durable memory.
PI_MEMORY_PROJECT=wolf
