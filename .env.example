# Dext provider selection (defaults to provider catalog active provider: glm)
# DEXT_PROVIDER=glm
# DEXT_MODEL=glm-4.6

# Optional hard overrides (usually managed via `dext auth ...`)
# DEXT_BASE_URL=https://api.z.ai/api/anthropic
# DEXT_API_KEY=...

# Provider-specific env fallbacks
# ZAI_API_KEY=...
# ANTHROPIC_API_KEY=...
# OPENAI_API_KEY=...
# DEEPSEEK_API_KEY=...
# CHATGPT_ACCESS_TOKEN=...
# OPENROUTER_API_KEY=...

DEXT_EXTERNAL_TIMEOUT_SECS=60
DEXT_BASH_TIMEOUT_SECS=60
DEXT_HOOK_TIMEOUT_SECS=60

# Optional: override detected model context window (tokens) and compaction threshold (chars)
# DEXT_CONTEXT_WINDOW_TOKENS=200000
# DEXT_MAX_HISTORY_CHARS=280000

# pi-memory: pin this repo to the explicit project name used for durable memory.
PI_MEMORY_PROJECT=dext
